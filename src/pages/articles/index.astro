---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { KIND_LABEL, articleSlug, formatDate, withBase } from '../../lib/site';

const entries = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const topics = [...new Set(entries.flatMap(({ data }) => data.topics))].sort();
---

<BaseLayout title="Articles" description="The complete Maddy index: concepts, proofs, problems, and working notes.">
  <div class="archive page-frame">
    <header class="page-header">
      <p class="eyebrow">The archive</p>
      <h1>Articles</h1>
      <p>Search the titles and abstracts, or narrow the index by field.</p>
    </header>
    <section class="archive-tools" aria-label="Filter articles">
      <label>
        <span>Search</span>
        <input type="search" placeholder="Try continuity or isomorphism" data-search />
      </label>
      <div class="topic-filters">
        <button data-topic="all" aria-pressed="true">All <span>{entries.length}</span></button>
        {topics.map((topic) => <button data-topic={topic.toLowerCase()} aria-pressed="false">{topic} <span>{entries.filter((entry) => entry.data.topics.includes(topic)).length}</span></button>)}
      </div>
      <p><strong data-count>{entries.length}</strong> entries</p>
    </section>
    <ol class="archive-list">
      {entries.map((entry) => (
        <li data-item data-topics={entry.data.topics.join('|').toLowerCase()} data-search={[entry.data.title, entry.data.description, ...entry.data.topics, ...entry.data.tags].join(' ').toLowerCase()}>
          <article>
            <div class="archive-meta"><span>{entry.data.topics[0]}</span><span>{KIND_LABEL[entry.data.kind]}</span><time>{formatDate(entry.data.date)}</time></div>
            <h2><a href={withBase(`/articles/${articleSlug(entry)}/`)}>{entry.data.title}</a></h2>
            <p>{entry.data.description}</p>
          </article>
          <a class="round-link" href={withBase(`/articles/${articleSlug(entry)}/`)} aria-label={`Read ${entry.data.title}`}>↗</a>
        </li>
      ))}
    </ol>
    <p class="no-results" data-empty hidden>No articles match that search.</p>
  </div>
  <script>
    const input = document.querySelector<HTMLInputElement>('[data-search]');
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-topic]')];
    const count = document.querySelector('[data-count]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    let topic = new URLSearchParams(location.search).get('topic')?.toLowerCase() || 'all';
    const run = () => {
      let visible = 0;
      const query = input?.value.trim().toLowerCase() || '';
      items.forEach((item) => {
        const show = (topic === 'all' || item.dataset.topics?.split('|').includes(topic)) && (!query || item.dataset.search?.includes(query));
        item.hidden = !show;
        if (show) visible += 1;
      });
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.topic === topic)));
    };
    input?.addEventListener('input', run);
    buttons.forEach((button) => button.addEventListener('click', () => { topic = button.dataset.topic || 'all'; run(); }));
    run();
  </script>
</BaseLayout>
