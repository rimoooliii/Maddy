---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { articleSlug } from '../../lib/site';
export async function getStaticPaths(){const entries=await getCollection('articles',({data})=>!data.draft);return entries.map(entry=>({params:{slug:articleSlug(entry)},props:{entry}}));}
const { entry }=Astro.props; const { Content }=await render(entry);
---
<ArticleLayout entry={entry}><Content /></ArticleLayout>
