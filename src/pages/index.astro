---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { KIND_LABEL, articleSlug, formatDate, withBase } from '../lib/site';

const entries = (await getCollection('articles', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = entries.find(({data}) => data.featured) ?? entries[0];
const recent = entries.filter(entry => entry.id !== featured?.id).slice(0,3);
const areas = [
  { symbol: '∫', name: '分析', question: '连续与无限如何被精确地把握？', topic: '分析' },
  { symbol: '≅', name: '代数', question: '结构为何比具体对象更重要？', topic: '代数' },
  { symbol: '△', name: '几何', question: '空间的性质如何转化为不变量？', topic: '几何' },
  { symbol: '𝔼', name: '概率', question: '不确定性怎样产生稳定规律？', topic: '概率' },
];
---
<BaseLayout>
  <div class="home page-frame">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">A personal mathematics notebook · since 2026</p>
        <h1 id="home-title">数学不是公式的仓库，<em>而是推理的练习。</em></h1>
        <p class="home-deck">Maddy 记录我如何理解一个概念、拆开一个证明、修正一个错误。每篇文章尽量回答一个清楚的问题。</p>
        <div class="hero-actions"><a class="button" href={withBase('/articles/')}>开始阅读</a><a class="text-link" href={withBase('/paths/')}>查看学习路径 →</a></div>
      </div>
      <aside class="problem-card" aria-label="本周问题">
        <div class="problem-label"><span>本周问题</span><span>№ 01</span></div>
        <p>为什么一个处处连续的函数，仍然可能处处不可导？</p>
        <div class="scribble" aria-hidden="true"><i>连续</i><span>⇏</span><i>光滑</i></div>
        <small>从“局部线性”重新理解导数</small>
      </aside>
    </section>

    <section class="knowledge-map" aria-labelledby="map-title">
      <div class="section-heading"><div><p class="eyebrow">知识轨道</p><h2 id="map-title">从问题进入，而不是从目录进入</h2></div><p>四个入口彼此相连；分类只是地图，不是围墙。</p></div>
      <div class="track" aria-label="数学领域">
        {areas.map((area, index) => <a href={`${withBase('/articles/')}?topic=${encodeURIComponent(area.topic)}`} class="track-stop"><span class="track-index">0{index+1}</span><b aria-hidden="true">{area.symbol}</b><strong>{area.name}</strong><small>{area.question}</small></a>)}
      </div>
    </section>

    <section class="latest" aria-labelledby="latest-title">
      <div class="section-heading"><div><p class="eyebrow">最近更新</p><h2 id="latest-title">正在学习</h2></div><a href={withBase('/articles/')}>全部文章</a></div>
      {featured && <article class="featured-entry">
        <div class="entry-number">01</div><div><div class="entry-meta"><span>{KIND_LABEL[featured.data.kind]}</span><span>{featured.data.level}</span><time>{formatDate(featured.data.date)}</time></div><h3><a href={withBase(`/articles/${articleSlug(featured)}/`)}>{featured.data.title}</a></h3><p>{featured.data.description}</p></div><a class="entry-arrow" href={withBase(`/articles/${articleSlug(featured)}/`)} aria-label={`阅读 ${featured.data.title}`}>↗</a>
      </article>}
      {recent.length > 0 && <ol class="recent-list">{recent.map((entry,index) => <li><span>0{index+2}</span><div><div class="entry-meta"><span>{KIND_LABEL[entry.data.kind]}</span><time>{formatDate(entry.data.date)}</time></div><a href={withBase(`/articles/${articleSlug(entry)}/`)}>{entry.data.title}</a></div><span>{entry.data.topics[0]}</span></li>)}</ol>}
    </section>

    <section class="method" aria-labelledby="method-title"><div><p class="eyebrow">写作约定</p><h2 id="method-title">一篇文章，解决一种“不明白”</h2></div><ol><li><span>直觉</span><p>先说明问题为何值得问，以及最朴素的想法。</p></li><li><span>定义</span><p>把模糊处变成可以检验的数学语言。</p></li><li><span>证明</span><p>标出关键转折，不隐藏真正困难的那一步。</p></li><li><span>反思</span><p>记录失败路径、边界条件与可以继续追问之处。</p></li></ol></section>
  </div>
</BaseLayout>
