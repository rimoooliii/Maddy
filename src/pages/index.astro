---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { KIND_LABEL, articleSlug, formatDate, withBase } from '../lib/site';

const entries = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = entries[0];
const essayHref = featured ? withBase(`/articles/${articleSlug(featured)}/`) : withBase('/articles/');
const movements = [
  { name: 'Integrality', mark: 'I', prompt: 'Rank-two geometry restricts every edge to multiplicity 0, 1, 2, or 3', anchor: 'simple-roots-turn-geometry-into-integers' },
  { name: 'Positivity', mark: 'II', prompt: 'The Cartan form turns finiteness into a spectral constraint', anchor: 'the-hidden-condition-is-positive-definiteness' },
  { name: 'Branching', mark: 'III', prompt: 'One reciprocal inequality produces D and the three E diagrams', anchor: 'one-inequality-produces-d_ne_6e_7e_8' },
  { name: 'Weighted edges', mark: 'IV', prompt: 'A determinant recurrence leaves only B, C, F, and G', anchor: 'multiple-edges-reduce-to-a-determinant-recurrence' },
];
---

<BaseLayout>
  <div class="home">
    <section class="hero page-frame" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">Long-form proof · Lie theory</p>
        <h1 id="home-title">Why the Dynkin<br /><em>list ends.</em></h1>
        <p class="home-deck">
          Positive-definite Cartan forms leave room for four infinite families,
          five exceptional diagrams, and nothing else.
        </p>
        <a class="primary-link" href={essayHref}>Read the essay <span>↗</span></a>
      </div>
      <div class="equation-field" aria-label="The positive-definiteness criterion for a three-armed Dynkin tree">
        <span class="field-label">The exceptional boundary</span>
        <div class="formula formula-a">1/(a+1)</div>
        <div class="formula formula-b">+ 1/(b+1) + 1/(c+1)</div>
        <div class="formula formula-c">&gt; 1</div>
        <div class="field-rule"></div>
        <p>Strict inequality gives finite type. Equality is affine.</p>
      </div>
    </section>

    <section class="field-index page-frame" aria-labelledby="fields-title">
      <div class="section-intro">
        <p class="eyebrow">The argument</p>
        <h2 id="fields-title">Four movements</h2>
      </div>
      <div class="field-grid">
        {movements.map((movement) => (
          <a href={`${essayHref}#${movement.anchor}`}>
            <span class="movement-mark" aria-hidden="true">{movement.mark}</span>
            <span><strong>{movement.name}</strong><small>{movement.prompt}</small></span>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </section>

    {featured && (
      <section class="latest page-frame" aria-labelledby="latest-title">
        <div class="section-intro latest-intro">
          <div><p class="eyebrow">Current essay</p><h2 id="latest-title">Structure and classification</h2></div>
          <a href={withBase('/articles/')}>Article index</a>
        </div>
        <article class="featured-entry">
          <div class="featured-meta">
            <span>{KIND_LABEL[featured.data.kind]}</span>
            <span>{featured.data.level}</span>
            <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
          </div>
          <h3><a href={essayHref}>{featured.data.title}</a></h3>
          <p>{featured.data.description}</p>
          <a class="round-link" href={essayHref} aria-label={`Read ${featured.data.title}`}>↗</a>
        </article>
      </section>
    )}

    <section class="editorial-note">
      <div class="page-frame">
        <p class="eyebrow">Central question</p>
        <p class="statement">How much graph can a positive form support?</p>
        <a href={`${essayHref}#the-list-reappears-because-the-form-reappears`}>Follow the boundary ↗</a>
      </div>
    </section>
  </div>
</BaseLayout>
