---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';

const paths = [
  { field: 'Analysis', name: 'From limits to measure', summary: 'Build precise language for continuity, local change, accumulation, and size.', steps: ['Sequences and limits', 'Continuity and compactness', 'Differentiation', 'Integration and measure'] },
  { field: 'Algebra', name: 'From equations to symmetry', summary: 'Move from solving for unknowns to studying operations and structure-preserving maps.', steps: ['Vector spaces', 'Linear maps', 'Groups and actions', 'Rings and fields'] },
  { field: 'Probability', name: 'From counting to convergence', summary: 'Start with finite sample spaces, then track random quantities across repeated trials.', steps: ['Counting', 'Conditional probability', 'Random variables', 'Laws of large numbers'] },
];
---

<BaseLayout title="Reading Paths" description="Three routes through the mathematical notes in Maddy.">
  <div class="paths-page page-frame">
    <header class="page-header">
      <p class="eyebrow">Reading paths</p>
      <h1>Follow the dependencies.</h1>
      <p>Each path records which ideas support the next one. Read in sequence or use the list to locate a missing prerequisite.</p>
    </header>
    <div class="path-list">
      {paths.map((path) => (
        <article>
          <div class="path-heading"><span>{path.field}</span><h2>{path.name}</h2><p>{path.summary}</p></div>
          <ol>{path.steps.map((step, index) => <li><span>{index + 1}</span><strong>{step}</strong></li>)}</ol>
          <a href={`${withBase('/articles/')}?topic=${encodeURIComponent(path.field)}`}>Browse {path.field.toLowerCase()} ↗</a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
