---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { SITE, KIND_LABEL, articleSlug, formatDate, readingMinutes, withBase } from '../lib/site';

interface Heading { depth: number; slug: string; text: string; }
interface Props { entry: CollectionEntry<'articles'>; headings?: Heading[]; }
const { entry, headings = [] } = Astro.props;
const { data } = entry;
const slug = articleSlug(entry);
const canonical = new URL(withBase(`/articles/${slug}/`), Astro.site);
const minutes = readingMinutes(entry.body ?? '');
const outline = headings.filter((heading) => heading.depth === 2 && heading.slug !== 'footnote-label');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.date.toISOString(),
  dateModified: (data.updated ?? data.date).toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: SITE.github },
  mainEntityOfPage: canonical.toString(),
  inLanguage: data.language,
  keywords: [...data.topics, ...data.tags].join(', '),
};
---

<BaseLayout title={data.title} description={data.description} lang={data.language} canonical={canonical} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={data.date.toISOString()} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <article class="article-page">
    <header class="article-header page-frame">
      <a class="back-link" href={withBase('/articles/')}>All articles</a>
      <div class="article-heading">
        <div>
          <p class="article-kicker">{KIND_LABEL[data.kind]} · {data.level}{data.series && ` · ${data.series}`}</p>
          <h1>{data.title}</h1>
          <p class="article-deck">{data.description}</p>
        </div>
        <dl class="article-facts">
          <div><dt>Published</dt><dd><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></dd></div>
          <div><dt>Reading time</dt><dd>{minutes} min</dd></div>
          {data.prerequisites.length > 0 && <div><dt>Prerequisites</dt><dd>{data.prerequisites.join(', ')}</dd></div>}
        </dl>
      </div>
    </header>
    <div class="article-canvas">
      {outline.length > 0 && (
        <nav class="article-outline" aria-label="Article sections">
          <p><span>Argument map</span><small>{outline.length} sections</small></p>
          <ol>
            {outline.map((heading, index) => (
              <li><a href={`#${heading.slug}`}><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a></li>
            ))}
          </ol>
        </nav>
      )}
      <div class="prose" data-article-body>
        <slot />
        {data.sources.length > 0 && (
          <section class="sources">
            <h2>References and further reading</h2>
            <ol>{data.sources.map(source => <li>{source.url ? <a href={source.url}>{source.label}</a> : source.label}{source.note && <span>: {source.note}</span>}</li>)}</ol>
          </section>
        )}
      </div>
      <aside class="sidenote-rail" data-sidenote-rail aria-label="Article notes"></aside>
    </div>
    <footer class="article-end page-frame">
      <p>Found a missing hypothesis or a cleaner proof?</p>
      <a href={`${SITE.repository}/issues/new`}>Open a correction ↗</a>
    </footer>
  </article>
  <script>
    import '../scripts/sidenotes';
  </script>
</BaseLayout>
