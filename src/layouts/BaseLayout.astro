---
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE, withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonical?: URL;
  type?: 'website' | 'article';
}

const {
  title = SITE.title,
  description = SITE.description,
  lang = 'en',
  canonical = new URL(Astro.url.pathname, Astro.site),
  type = 'website',
} = Astro.props;
const fullTitle = title === SITE.title ? title : `${title} — ${SITE.name}`;
const currentPath = Astro.url.pathname;
const articlesHref = withBase('/articles/');
const pathsHref = withBase('/paths/');
const aboutHref = withBase('/about/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8f9fd" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={withBase('/rss.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-mark" href={withBase('/')} aria-label="Maddy home">
          <span>Maddy</span>
          <small>Mathematics by RIMO</small>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href={articlesHref} aria-current={currentPath.startsWith(articlesHref) ? 'page' : undefined}>Articles</a>
          <a href={pathsHref} aria-current={currentPath.startsWith(pathsHref) ? 'page' : undefined}>Paths</a>
          <a href={aboutHref} aria-current={currentPath.startsWith(aboutHref) ? 'page' : undefined}>About</a>
          <a class="nav-source" href={SITE.repository}>Source ↗</a>
        </nav>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <a class="footer-mark" href={withBase('/')}>Maddy</a>
        <p>{SITE.motto}</p>
        <nav aria-label="Footer navigation">
          <a href={withBase('/rss.xml')}>RSS</a>
          <a href={SITE.repository}>GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
